# Mapbox basemap. A public (pk.) token is meant to live in client code — it ends up in
# the bundle no matter where it is kept here — so the protection that matters is a URL
# restriction on the token in the Mapbox account, not secrecy in this file.
#
# Leave VITE_MAPBOX_TOKEN empty and the map draws from this build's own GeoJSON with no
# basemap. That path is tested, so a contributor without a token still gets a working map.
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoic3RpbGVzIiwiYSI6ImNsd3Rpc3V2aTAzeXUydm9sMHdoN210b2oifQ.66AJmPYxe2ixku1o7Rwdlg
VITE_MAPBOX_STYLE=mapbox://styles/stiles/cmiuh91nz003q01su2wd5b64l
